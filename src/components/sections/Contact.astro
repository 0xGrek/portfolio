---
import { t } from '../../i18n/index';
import type { Lang } from '../../i18n/index';
import SectionTitle from '../ui/SectionTitle.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const socials = [
  {
    name: 'Email',
    href: 'mailto:ivanenko.pt@gmail.com',
    label: 'ivanenko.pt@gmail.com',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>`,
    color: 'rgba(88,166,255,0.15)',
    borderColor: 'rgba(88,166,255,0.35)',
    iconColor: '#58a6ff',
    external: false,
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/in/ivanenko-pt',
    label: 'ivanenko-pt',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
    color: 'rgba(10,102,194,0.12)',
    borderColor: 'rgba(10,102,194,0.4)',
    iconColor: '#0a66c2',
    external: true,
  },
];
---

<section id="contact" class="py-24" style="background-color: transparent;">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="reveal">
      <SectionTitle
        title={t(lang, 'contact_title')}
        subtitle={t(lang, 'contact_subtitle')}
      />
    </div>

    <!-- Available badge + location -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-10 reveal">
      <div
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full pulse-green-glow"
        style="background-color: rgba(63,185,80,0.12); color: #3fb950; border: 1px solid rgba(63,185,80,0.35);"
      >
        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
        <span class="text-sm font-medium">{t(lang, 'contact_available')}</span>
      </div>

      <div
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm"
        style="background-color: var(--bg); color: var(--text-secondary); border: 1px solid var(--border);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <a
          href="https://www.google.com/maps/place/Lisbon,+Portugal"
          target="_blank"
          rel="noopener noreferrer"
          class="location-link"
        >Lisbon, Portugal</a> · Remote-ready worldwide
      </div>
    </div>

    <!-- Social link cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {socials.map((s, index) => (
        <a
          href={s.href}
          target={s.external ? '_blank' : undefined}
          rel={s.external ? 'noopener noreferrer' : undefined}
          aria-label={s.name}
          class="social-card group flex items-center gap-4 px-5 py-4 rounded-xl text-left reveal"
          style={`background-color: var(--card-bg); border: 1px solid ${s.borderColor}; transition-delay: ${index * 0.07}s;`}
        >
          <!-- Icon -->
          <div
            class="flex-shrink-0 w-11 h-11 rounded-lg flex items-center justify-center"
            style={`background-color: ${s.color}; color: ${s.iconColor};`}
          >
            <Fragment set:html={s.icon} />
          </div>

          <!-- Text -->
          <div class="min-w-0 flex-1 text-left">
            <p class="text-xs font-semibold uppercase tracking-wider mb-0.5" style="color: var(--text-secondary);">
              {s.name}
            </p>
            <p class="text-sm font-medium truncate" style="color: var(--text);">
              {s.label}
            </p>
          </div>

          <!-- Arrow -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="flex-shrink-0 social-card-arrow"
            style="color: var(--accent);"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .location-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .location-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: rgba(var(--accent-rgb), 0.6);
  }

  .social-card {
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.25s ease,
                border-color 0.25s ease;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }
  .social-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
    transform: translateX(-100%) skewX(-12deg);
    pointer-events: none;
    z-index: 1;
  }
  .social-card:hover::before {
    animation: shine-sweep 0.55s ease forwards;
  }
  .social-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md), 0 0 0 1px rgba(var(--accent-rgb), 0.2);
    border-color: rgba(var(--accent-rgb), 0.45) !important;
  }
  .social-card:active {
    transform: translateY(-2px);
    transition-duration: 0.1s;
  }
  .social-card-arrow {
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .social-card:hover .social-card-arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
