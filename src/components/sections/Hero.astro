---
import { t } from '../../i18n/index';
import type { Lang } from '../../i18n/index';
import Button from '../ui/Button.astro';
import { CONTACT, LOCATION } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const socials = [
  { name: 'LinkedIn', href: CONTACT.linkedinUrl, external: true, icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>` },
  { name: 'GitHub', href: CONTACT.githubUrl, external: true, icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.02 1.75 2.68 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.26 5.69.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12c0-6.27-5.23-11.5-11.5-11.5z"/></svg>` },
  { name: 'Email', href: CONTACT.emailHref, external: false, icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>` },
];
---

<section
  id="hero"
  class="relative min-h-screen flex items-center pt-16 overflow-hidden"
  style="background-color: transparent;"
>
  <!-- Animated gradient background -->
  <div class="absolute inset-0 pointer-events-none hero-animated-bg"></div>
  <!-- Dot-grid background pattern -->
  <div
    class="absolute inset-0 pointer-events-none hero-dots"
  ></div>
  <!-- Gradient overlay top/bottom -->
  <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to bottom, var(--bg) 0%, transparent 18%, transparent 80%, var(--bg) 100%);"></div>
  <!-- Radial glow center — stronger, layered -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 70% 60% at 50% 40%, rgba(var(--accent-rgb), 0.07) 0%, rgba(var(--accent-rgb), 0.02) 40%, transparent 70%);"></div>
  <!-- Floating particles (CSS only) -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden hero-particles" aria-hidden="true">
    <span class="particle particle-1"></span>
    <span class="particle particle-2"></span>
    <span class="particle particle-3"></span>
    <span class="particle particle-4"></span>
    <span class="particle particle-5"></span>
    <span class="particle particle-6"></span>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Text content -->
      <div class="space-y-6 hero-content">
        <!-- Name -->
        <div>
          <h1 class="text-fluid-hero font-bold leading-tight gradient-text" style="letter-spacing: -0.02em;">
            {t(lang, 'hero_name')}
          </h1>
          <p class="text-lg sm:text-xl font-semibold mt-2 hero-role" style="color: var(--accent);">
            {t(lang, 'hero_title')}
          </p>
        </div>

        <!-- Title / Subtitle -->
        <div class="space-y-1">
          <p class="text-lg sm:text-xl font-bold leading-snug hero-subtitle-lead" style="color: var(--text);">
            {t(lang, 'hero_subtitle_lead')}
          </p>
          <p class="text-base sm:text-lg font-normal leading-relaxed hero-subtitle-body" style="color: var(--text-secondary);">
            {t(lang, 'hero_subtitle_body')}
          </p>
        </div>

        <!-- Status badges -->
        <div class="flex flex-wrap gap-3">
          <span
            class="flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium"
            style="background-color: rgba(63,185,80,0.12); color: #3fb950; border: 1px solid rgba(63,185,80,0.35); animation: pulseGlow 2.8s ease-in-out infinite;"
          >
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            {t(lang, 'hero_available')}
          </span>
          <span class="flex items-center gap-2 px-3 py-1.5 rounded-full text-sm font-medium" style="background-color: var(--bg-secondary); color: var(--text-secondary); border: 1px solid var(--border);">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <a
              href={LOCATION.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="location-link"
              style="text-decoration: none;"
            >{t(lang, 'hero_location')}</a>
            <span aria-hidden="true" style="opacity: 0.6;">·</span>
            <span id="hero-tz">{t(lang, 'hero_location_fallback')}</span>
          </span>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4">
          <Button href="#projects" variant="primary" size="lg" class="magnetic">
            {t(lang, 'hero_cta_projects')}
          </Button>
          <Button href="#contact" variant="secondary" size="lg" class="magnetic">
            {t(lang, 'hero_cta_contact')}
          </Button>
        </div>

        <!-- Social links -->
        <div class="flex items-center gap-4 pt-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target={s.external ? '_blank' : undefined}
              rel={s.external ? 'noopener noreferrer' : undefined}
              aria-label={s.name}
              class={`magnetic social-hover social-hero--${s.name.toLowerCase().replace(/[^a-z]/g, '')}`}
              style="color: var(--text-secondary); display: inline-flex;"
            >
              <Fragment set:html={s.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Right: Avatar (sphere moved to BaseLayout as fixed background) -->
      <div class="flex justify-center lg:justify-end order-first lg:order-last">
        <div class="relative" style="overflow: visible;">
          <!-- Glow effect — layered for depth -->
          <div
            class="absolute inset-0 rounded-full blur-3xl opacity-30"
            style="background: radial-gradient(circle, var(--accent) 0%, rgba(var(--accent-rgb), 0.3) 60%, transparent 100%); transform: scale(1.4);"
          ></div>
          <!-- Decorative spinning ring -->
          <div
            class="absolute inset-0 rounded-full border-2"
            style="border-color: transparent; border-top-color: var(--accent); opacity: 0.4; animation: spin-slow 8s linear infinite; transform: scale(1.12); z-index: 4;"
          ></div>
          <!-- Second ring opposite -->
          <div
            class="absolute inset-0 rounded-full border"
            style="border-color: transparent; border-bottom-color: rgba(var(--accent-rgb), 0.3); animation: spin-slow 12s linear infinite reverse; transform: scale(1.2); z-index: 4;"
          ></div>
        </div>
      </div>
    </div>

    <!-- Scroll-down indicator -->
    <div id="hero-scroll-indicator" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 no-print" style="transition: opacity 0.5s ease;">
      <span class="text-xs font-mono" style="color: var(--text-secondary); opacity: 0.6;">{t(lang, 'hero_scroll_hint')}</span>
      <svg
        class="animate-bounce-scroll"
        xmlns="http://www.w3.org/2000/svg"
        width="16" height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        style="color: var(--text-secondary); opacity: 0.5;"
      >
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </div>
</section>

<style>
  /* Animated gradient background */
  .hero-animated-bg {
    background: linear-gradient(
      135deg,
      rgba(var(--accent-rgb), 0.04) 0%,
      rgba(163, 113, 247, 0.03) 25%,
      rgba(var(--accent-rgb), 0.02) 50%,
      rgba(88, 166, 255, 0.04) 75%,
      rgba(var(--accent-rgb), 0.03) 100%
    );
    background-size: 400% 400%;
    animation: hero-gradient-shift 18s ease infinite;
  }

  .hero-dots {
    background-image:
      radial-gradient(circle, rgba(var(--accent-rgb), 0.08) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.8;
  }

  /* Floating particles */
  .particle {
    position: absolute;
    border-radius: 50%;
    background: rgba(var(--accent-rgb), 0.25);
    pointer-events: none;
  }
  .particle-1 { width: 4px; height: 4px; top: 15%; left: 12%; animation: float-particle 6s ease-in-out infinite; }
  .particle-2 { width: 3px; height: 3px; top: 28%; left: 85%; animation: float-particle 8s ease-in-out infinite 1.2s; background: rgba(163, 113, 247, 0.3); }
  .particle-3 { width: 5px; height: 5px; top: 65%; left: 8%;  animation: float-particle 7s ease-in-out infinite 0.6s; }
  .particle-4 { width: 3px; height: 3px; top: 72%; left: 78%; animation: float-particle 9s ease-in-out infinite 2s; background: rgba(88, 166, 255, 0.35); }
  .particle-5 { width: 4px; height: 4px; top: 42%; left: 92%; animation: float-particle 6.5s ease-in-out infinite 3s; }
  .particle-6 { width: 3px; height: 3px; top: 55%; left: 22%; animation: float-particle 10s ease-in-out infinite 1.5s; background: rgba(163, 113, 247, 0.25); }

  @media (max-width: 768px) {
    .hero-particles { display: none; }
    .hero-animated-bg { animation-duration: 30s; }
  }

  /* Staggered fade-in for hero content */
  .hero-content > * {
    animation: fade-in-up 0.65s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  .hero-content > *:nth-child(1) { animation-delay: 0.05s; }
  .hero-content > *:nth-child(2) { animation-delay: 0.18s; }
  .hero-content > *:nth-child(3) { animation-delay: 0.3s; }
  .hero-content > *:nth-child(4) { animation-delay: 0.4s; }
  .hero-content > *:nth-child(5) { animation-delay: 0.5s; }
  .hero-content > *:nth-child(6) { animation-delay: 0.6s; }
  .hero-content > *:nth-child(7) { animation-delay: 0.7s; }

  /* Subtitle lines — extra slight blur-to-sharp effect */
  .hero-subtitle-lead {
    animation: fade-in-up 0.65s cubic-bezier(0.4, 0, 0.2, 1) 0.3s both,
               hero-blur-in 0.8s ease 0.3s both;
  }
  .hero-subtitle-body {
    animation: fade-in-up 0.65s cubic-bezier(0.4, 0, 0.2, 1) 0.42s both,
               hero-blur-in 0.8s ease 0.42s both;
  }

  .location-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .location-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: rgba(var(--accent-rgb), 0.6);
  }

  /* Platform-specific hover colors for hero socials */
  .social-hero--linkedin:hover { color: #0a66c2 !important; }
  .social-hero--github:hover { color: var(--text) !important; }
  .social-hero--email:hover { color: var(--accent) !important; }
</style>

<script is:inline>
  (function () {
    var indicator = document.getElementById('hero-scroll-indicator');
    if (!indicator) return;
    window.addEventListener('scroll', function () {
      if (window.scrollY > 100) {
        indicator.style.opacity = '0';
        indicator.style.pointerEvents = 'none';
      } else {
        indicator.style.opacity = '1';
        indicator.style.pointerEvents = 'auto';
      }
    }, { passive: true });
  })();
</script>

<script is:inline>
  (function () {
    // Live Lisbon time + UTC offset, computed from Intl only (no libs).
    // WET (UTC+0) in winter, WEST (UTC+1) in summer — the IANA tz database
    // handles the DST switch automatically, we just read it each tick.
    var el = document.getElementById('hero-tz');
    if (!el || typeof Intl === 'undefined' || !Intl.DateTimeFormat) return;
    var TZ = 'Europe/Lisbon';

    function offsetMinutes(date) {
      var dtf = new Intl.DateTimeFormat('en-US', {
        timeZone: TZ, hour12: false,
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit', second: '2-digit',
      });
      var parts = {};
      dtf.formatToParts(date).forEach(function (p) { parts[p.type] = p.value; });
      var hour = parts.hour === '24' ? 0 : Number(parts.hour);
      var asUTC = Date.UTC(
        Number(parts.year), Number(parts.month) - 1, Number(parts.day),
        hour, Number(parts.minute), Number(parts.second)
      );
      return Math.round((asUTC - date.getTime()) / 60000);
    }

    function update() {
      try {
        var now = new Date();
        var timeStr = new Intl.DateTimeFormat('en-GB', {
          timeZone: TZ, hour: '2-digit', minute: '2-digit', hour12: false,
        }).format(now);
        var offMin = offsetMinutes(now);
        var sign = offMin >= 0 ? '+' : '-';
        var offHours = Math.abs(offMin) / 60;
        el.textContent = timeStr + ' (UTC' + sign + offHours + ')';
      } catch (e) {
        // Leave the SSR fallback text in place on any failure.
      }
    }

    update();
    setInterval(update, 60000);
  })();
</script>
