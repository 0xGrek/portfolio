---
import type { Lang } from '../../i18n/index';
import { t } from '../../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Serhii',
  alternateName: '0xGrek',
  url: `https://0xgrek.com/${lang}/`,
  image: 'https://0xgrek.com/og-default.png',
  description: t(lang, 'meta_description'),
  jobTitle: t(lang, 'hero_title'),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lisbon',
    addressCountry: 'PT',
  },
  sameAs: [
    'https://github.com/0xGrek',
    'https://linkedin.com/in/ivanenko-pt',
  ],
  knowsAbout: [
    'AI Engineering',
    'Software Development',
    'Data Pipelines',
    'AI Orchestration',
    'Multi-agent Systems',
    'Workflow Automation',
    'Python Programming',
    'TypeScript',
    'Product Automation',
  ],
  knowsLanguage: ['Ukrainian', 'English', 'Portuguese', 'Russian'],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
