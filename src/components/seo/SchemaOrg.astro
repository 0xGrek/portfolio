---
import type { Lang } from '../../i18n/index';
import { t } from '../../i18n/index';
import { SITE_URL, OG_IMAGE_PATH, CONTACT, LOCATION } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Serhii',
  alternateName: CONTACT.githubHandle,
  url: `${SITE_URL}/${lang}/`,
  image: `${SITE_URL}${OG_IMAGE_PATH}`,
  description: t(lang, 'meta_description'),
  jobTitle: t(lang, 'hero_title'),
  address: {
    '@type': 'PostalAddress',
    addressLocality: LOCATION.city,
    addressCountry: LOCATION.countryCode,
  },
  sameAs: [
    CONTACT.githubUrl,
    CONTACT.linkedinUrl,
  ],
  knowsAbout: [
    'AI Engineering',
    'Software Development',
    'Data Pipelines',
    'AI Orchestration',
    'Multi-agent Systems',
    'Workflow Automation',
    'Python Programming',
    'TypeScript',
    'Product Automation',
  ],
  knowsLanguage: ['Ukrainian', 'English', 'Portuguese', 'Russian'],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
